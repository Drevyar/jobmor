# JobMor – Environment Variables Template
#
# Copy this file to .env and fill in your credentials.
# NEVER commit the .env file to Git.
#
# How to get these values:
#   1. Go to https://supabase.com and open your project.
#   2. Navigate to Project Settings → API.
#   3. Copy the Project URL and Publishable key.
#
# Variables prefixed with EXPO_PUBLIC_ are safe to expose to the client bundle.
# They must not contain server-side secrets.

# ─── Supabase ─────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never put the service_role key in an EXPO_PUBLIC_* variable.
# The service_role key must never be bundled into the mobile application.
